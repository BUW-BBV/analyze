# Public host name of the analyzer
ANALYZER_HOST=analyzer.example.org
# Keycloak realm that signs people in, and its host name
OIDC_ISSUER=https://keycloak.example.org/realms/example
OIDC_HOST=keycloak.example.org
# Secret of the Keycloak client "analyzer" (Keycloak admin console: Clients, analyzer, Credentials)
OAUTH2_PROXY_CLIENT_SECRET=
# Random key for the session cookie: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
# Password of the backup repository (restic). Keep a copy somewhere safe: openssl rand -base64 32
RESTIC_PASSWORD=
